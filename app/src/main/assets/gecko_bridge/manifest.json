{
  "manifest_version": 2,
  "name": "SafeScan native bridge",
  "version": "1.0",
  "description": "SafeScan local native bridge",
  "permissions": ["nativeMessaging"],
  "background": {"scripts": ["background.js"]},
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["bridge.js"],
    "run_at": "document_start"
  ]
}
